# Generate a new hex password with: openssl rand -hex 24
# Existing database installations must retain their existing password.
DB_PASSWORD=
ADMIN_INITIAL_USERNAME=admin
# Fresh installations only; at least 12 characters.
ADMIN_INITIAL_PASSWORD=
ADMIN_PATH=/admin
PUBLIC_BASE_URL=https://nexus.example.com
# Additional trusted HTTPS origins, comma-separated; no paths or wildcards.
ALLOWED_ORIGINS=
SESSION_HOURS=24

# Optional Google OIDC. Leave both empty to use local login only.
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
CF_TURNSTILE_SITE_KEY=
CF_TURNSTILE_SECRET_KEY=

# Bind locally for a host reverse proxy. Set NEXUS_BIND=0.0.0.0 for remote access.
NEXUS_BIND=127.0.0.1
NEXUS_PORT=3001
TZ=Asia/Shanghai
RUST_LOG=info,nexus=info
CARTO_API_KEY=
MAP_TILE_URL=

DB_MAX_CONNECTIONS=24
GEO_CACHE_MB=16
INGEST_CONCURRENCY=64
LIVE_QUEUE_CAPACITY=8192
LOG_QUEUE_CAPACITY=16384
PG_MAX_CONNECTIONS=80
PG_SHARED_BUFFERS=128MB
PG_EFFECTIVE_CACHE_SIZE=512MB
PG_WORK_MEM=4MB
